# Salin berkas ini menjadi `.env` di folder yang sama, lalu isi.

# Alamat image aplikasi, lengkap dengan versinya. Anda menerimanya dari
# Kemal Office Studio bersama akses ke registry.
KOS_WEB_IMAGE=

# Alamat aplikasi, tanpa https://.
# Jaringan lokal: alamat IP server, misalnya 192.168.1.10
# Internet: nama domain, misalnya absensi.perusahaan.co.id
KOS_SITE_ADDRESS=

# Sertifikat HTTPS.
# `internal` untuk jaringan lokal: server membuat sertifikatnya sendiri.
# Untuk domain yang terbuka ke internet, ganti dengan alamat email pengelola
# supaya sertifikat resmi diterbitkan otomatis.
KOS_TLS=internal

# Token pemasangan untuk membuat Superadmin pertama di halaman /setup.
# Minimal 32 karakter acak. Kosongkan lagi setelah Superadmin dibuat.
KOS_SETUP_TOKEN=

# Isi hanya bila database dipasangi autentikasi (lihat docker-compose.yml).
KOS_DATABASE_AUTH_TOKEN=
